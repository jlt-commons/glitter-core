;; Babashka runner for glitter-core — the natives-free reconciler and
;; IRender/IMemory protocol seam extracted from glitter.
;;   bb info       task cheat-sheet (start here)
;;   bb test       run the unit suite (jolt -M:test)
;;   bb site:build | site:serve [port] | site:clean
;;                 local preview of the docs site (needs a docs-engine checkout)
;; NOTE: task bodies are EDN-parsed — no #"regex", @deref, or #(...) reader macros.
{:min-bb-version "1.3.0"
 :tasks
 {:requires ([babashka.fs :as fs])

  :init
  (do
    ;; --- documentation site ------------------------------------------------
    ;; The generator lives in jlt-commons/docs-engine, not here. The site is
    ;; built in CI (.github/workflows/site.yml, which pins an engine tag), so
    ;; these tasks exist only for local preview and are the one place that
    ;; needs a checkout of the engine on disk.
    (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")

    (defn docs-engine-dir
      "Where the engine is checked out: $JLT_DOCS_ENGINE, else a sibling
       directory, else the usual spot. nil when none of them exist."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "JLT_DOCS_ENGINE")
              "../docs-engine"
              (str home "/dev/jlt-commons/docs-engine")]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
             first)))

    (defn site-task
      "Runs one of the engine's tasks against this project."
      [task & args]
      (if-let [engine (docs-engine-dir)]
        (let [argv (into ["bb" task (str (fs/cwd))] (remove nil? args))
              res  (apply shell {:dir (str engine) :continue true} argv)]
          (when-not (zero? (:exit res)) (System/exit (:exit res))))
        (do
          (println "The docs engine is not checked out anywhere I looked:")
          (println "  $JLT_DOCS_ENGINE, ../docs-engine, ~/dev/jlt-commons/docs-engine")
          (println)
          (println "  git clone" docs-engine-repo "../docs-engine")
          (println)
          (println "CI does not need this — it checks the engine out itself.")
          (System/exit 1)))))

  info {:doc "Task cheat-sheet (start here; easier to scan than `bb tasks`)"
        :task
        (let [esc (str (char 27) "[")
              col (fn [c s] (str esc c "m" s esc "0m"))
              hdr (fn [s] (println (str "\n" (col "35" (str "── " s " ──")))))
              row (fn [t d] (println (str "  " (col "36" (format "%-24s" (str "bb " t))) d)))]
          (println (col "1;35" "\nglitter-core — natives-free reconciler extracted from glitter"))
          (hdr "Verify")
          (row "test" "run the unit suite (jolt -M:test)")
          (hdr "Docs (local preview; CI publishes on merge)")
          (row "site:build" "build the documentation site into _site/")
          (row "site:serve [port]" "build, then serve it at http://localhost:3000")
          (row "site:clean" "delete the _site/ build output")
          (println (str "\n" (col "2" "first run: bb test  ·  CI gate: bb test"))))}

  test {:doc "Run the unit suite"
        :task (shell "jolt" "-M:test")}

  ;; --- Docs -----------------------------------------------------------------
  ;; Local preview only. CI owns publishing: .github/workflows/site.yml builds
  ;; the site on every pull request and deploys it to GitHub Pages from main,
  ;; so a docs change goes live on merge without anyone running anything.
  site:build
  {:doc "Build the documentation site into _site/ (needs a docs-engine checkout)"
   :task (site-task "build")}

  site:serve
  {:doc "Build the docs site and serve it at http://localhost:3000 (bb site:serve [port])"
   :task (site-task "serve" (first *command-line-args*))}

  site:clean
  {:doc "Delete the _site/ build output"
   :task (site-task "clean")}}}
